# ========================
# TalentFlow — Monorepo
# ========================

# Segredos — nunca versionar
**/.env
**/.env.*
!**/.env.example

# Python
talentflow-api/venv/
talentflow-api/__pycache__/
talentflow-api/**/__pycache__/
talentflow-api/**/*.pyc
talentflow-api/**/*.pyo
talentflow-api/.pytest_cache/
talentflow-api/*.egg-info/

# Alembic — manter o código, ignorar apenas o cache
talentflow-api/alembic/__pycache__/

# Next.js
talentflow-web/.next/
talentflow-web/out/
talentflow-web/build/
talentflow-web/node_modules/
talentflow-web/.pnp
talentflow-web/.pnp.*

# Logs
**/*.log
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp
*.swo

# TypeScript
talentflow-web/*.tsbuildinfo
talentflow-web/next-env.d.ts

# Vercel
talentflow-web/.vercel

# ========================
# Seguranca — hardening
# ========================

# PDFs de teste nunca commitados (gerar via generate_test_pdf.py)
*.pdf
# Excecoes futuras: !docs/whitepapers/*.pdf

# Graphify AST cache — vaza paths absolutos locais do ambiente de desenvolvimento
graphify-out/cache/
graphify-out/*/cache/

# Scripts one-shot de migracao de banco (liquidas apos uso); nuca re-versionar
talentflow-api/migrate_db_data.py
